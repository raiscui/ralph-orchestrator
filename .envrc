# 本文件用于 direnv（开发/测试便利），请勿在这里放敏感信息。
# 启用：在项目根目录执行 `direnv allow`

# =============================================================================
# mock-cli / 并行模式回放（cassette）
# =============================================================================
#
# 说明：
# - 在并行模式下，`ralph` 会在 spawn 自定义 backend 时自动注入这两个环境变量，
#   用于让 `ralph-e2e mock-cli` 按实例分流回放输出。
# - 这里提供空默认值，便于本地直接运行/调试（不影响实际注入）。
export RALPH_HAT_INSTANCE_ID=""
export RALPH_HAT_ID=""

# mock-cli 允许执行的命令白名单（逗号分隔），覆盖 `--allow` 参数（便于 CI 注入）。
# 默认空：不允许执行任何命令。
export RALPH_MOCK_ALLOW=""

