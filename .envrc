# 本文件用于 direnv（开发/测试便利），请勿在这里放敏感信息。
# 启用：在项目根目录执行 `direnv allow`

# =============================================================================
# mock-cli / 并行模式回放（cassette）
# =============================================================================
#
# 说明：
# - 在并行模式下，`ralph` 会在 spawn 自定义 backend 时自动注入这两个环境变量，
#   用于让 `ralph-e2e mock-cli` 按实例分流回放输出。
# - 这里提供空默认值，便于本地直接运行/调试（不影响实际注入）。
export RALPH_HAT_INSTANCE_ID=""
export RALPH_HAT_ID=""

# mock-cli 允许执行的命令白名单（逗号分隔），覆盖 `--allow` 参数（便于 CI 注入）。
# 默认空：不允许执行任何命令。
export RALPH_MOCK_ALLOW=""

# =============================================================================
# TUI: 动画开关（无障碍 / 可回放环境）
# =============================================================================
#
# 说明：
# - 设为 "1" 可禁用启动打开动画与其它动态效果（降低闪烁，便于录屏/CI/无障碍）。
# - 默认 "0"：启用（但会在窗口过小等情况下自动降级）。
export RALPH_TUI_REDUCED_MOTION="0"

# =============================================================================
# Codex app-server: RPC trace(排障)
# =============================================================================
#
# 说明:
# - `RALPH_CODEX_APP_SERVER_TRACE=1` 会在 parallel app-server runtime 把关键 RPC send/recv 打到 stderr。
# - `RALPH_CODEX_APP_SERVER_TRACE_STEER_INPUT=1` 会额外打印 `turn/steer` 与 `turn/start` 的 input 预览(截断)。
# - `RALPH_CODEX_APP_SERVER_TRACE_JSON=1` 会对部分通知附带 JSON 预览(更吵,仅深度排障用)。
export RALPH_CODEX_APP_SERVER_TRACE="0"
export RALPH_CODEX_APP_SERVER_TRACE_STEER_INPUT="0"
export RALPH_CODEX_APP_SERVER_TRACE_JSON="0"

# =============================================================================
# macOS: Apple toolchain 选择(避免 Xcode license 阻塞)
# =============================================================================
#
# 说明:
# - Rust 在 macOS 上编译/链接时会通过 `xcrun` 寻找 `clang`/`ld`/SDK。
# - 如果 `xcode-select -p` 指向 Xcode.app 且未接受 license,`cargo test` 可能在链接阶段失败(exit 69):
#   `You have not agreed to the Xcode license agreements...`
# - 若已安装 Command Line Tools,优先使用它可以绕过 Xcode.app license(无需 sudo)。
#
# 策略:
# - 仅在未显式设置 `DEVELOPER_DIR` 且 CLT 目录存在时才设置,避免覆盖用户的显式选择。
# - 若你需要强制使用 Xcode.app,可以在 shell 里先设置 `DEVELOPER_DIR=.../Xcode.app/...` 覆盖此默认。
if [ -z "${DEVELOPER_DIR:-}" ] && [ -d "/Library/Developer/CommandLineTools" ]; then
  export DEVELOPER_DIR="/Library/Developer/CommandLineTools"
fi

# =============================================================================
# Startup resource bootstrap
# =============================================================================
#
# 说明:
# - `RALPH_HOME` 用于覆盖 Ralph 用户资源根目录。
# - 代码会把启动资源同步到 `$RALPH_HOME/resources`。
# - 默认留空,表示使用用户目录兜底(当前 Unix 心智为 `$HOME/.ralph/resources`)。
export RALPH_HOME=""
